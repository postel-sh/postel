# Local SQLite file — no secrets, safe to commit. Point this at Postgres/MySQL
# in a real deployment; PrismaStorage's `dialect` option would change to match.
# Resolved relative to prisma/schema.prisma, not the cwd — this lands at
# prisma/dev.db.
DATABASE_URL="file:./dev.db"

# Base URL the app uses to build its own webhook receiver URL and JWKS URI.
# Override when running behind a different host/port.
APP_BASE_URL="http://localhost:3000"
