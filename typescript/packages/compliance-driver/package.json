{
  "name": "@postel/compliance-driver",
  "private": true,
  "version": "0.0.0",
  "description": "HTTP control-plane shim the @postel/compliance suite drives in --sender-control mode.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "bin": {
    "compliance-driver-ts": "./dist/cli.js"
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@postel/core": "workspace:*",
    "@postel/pg": "workspace:*",
    "pg": "8.20.0"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "10.13.2",
    "@types/node": "20.17.10",
    "@types/pg": "8.20.0"
  }
}
