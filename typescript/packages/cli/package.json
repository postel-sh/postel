{
  "name": "@postel/cli",
  "version": "0.0.0",
  "description": "The postel CLI binary — postel migrate.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/postel-sh/postel.git",
    "directory": "typescript/packages/cli"
  },
  "homepage": "https://postel.dev",
  "bugs": "https://github.com/postel-sh/postel/issues",
  "keywords": ["webhooks", "standard-webhooks", "cli", "migrate", "postel"],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "bin": {
    "postel": "./dist/cli.js"
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@postel/mysql": "workspace:*",
    "@postel/pg": "workspace:*",
    "@postel/sqlite": "workspace:*",
    "better-sqlite3": "12.10.0",
    "mysql2": "3.11.5",
    "pg": "8.20.0"
  },
  "devDependencies": {
    "@postel/storage-testkit": "workspace:*",
    "@testcontainers/mysql": "10.13.2",
    "@testcontainers/postgresql": "10.13.2",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "20.17.10",
    "@types/pg": "8.20.0"
  }
}
